# 旧仓库只作参考；其中包含私密备份，不进入新仓库。
/dotfile/
/backup/

# Fish 会自行写入这些运行数据；凭据单独保存在 backup/private/。
/fish/.config/fish/fish_variables
/fish/.config/fish/fish_history
/fish/.config/fish/conf.d/chromium.fish
/local/.local/share/fish/fish_history

__pycache__/

# lazy.nvim 的锁文件由插件管理器自行生成和更新。
/nvim/.config/nvim/lazy-lock.json

/private/
