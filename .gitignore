# 旧仓库只作参考；其中包含私密备份，不进入新仓库。
/dotfile/
/backup/

# Fish 会自行写入这些运行数据；凭据单独保存在 backup/private/。
/user/fish/.config/fish/fish_variables
/user/fish/.config/fish/fish_history
/user/fish/.config/fish/conf.d/chromium.fish
/user/local/.local/share/fish/fish_history

# 独立项目的本地源码、构建文件和数据不进入配置仓库。
/user/local/.local/src/

__pycache__/

# lazy.nvim 的锁文件由插件管理器自行生成和更新。
/dev/nvim/.config/nvim/lazy-lock.json

/private/
