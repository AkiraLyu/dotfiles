[%General]
author=Akira; OpenAI Codex; SVG artwork adapted from KvKonqi by Keystistic
comment=KDE Breeze 6.7 geometry with the Layan dark palette and translucency
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=true
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=0
toolbar_interior_spacing=0
toolbar_separator_thickness=8
center_toolbar_handle=true
spread_progressbar=true
composite=true
menu_shadow_depth=5
menu_separator_height=9
spread_menuitems=false
tooltip_shadow_depth=6
splitter_width=1
scroll_width=8
scroll_arrows=false
scroll_min_extent=20
slider_width=6
slider_handle_width=20
slider_handle_length=20
tickless_slider_handle_size=20
check_size=20
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=true
blurring=true
popup_blurring=true
vertical_spin_indicators=true
spin_button_width=20
fill_rubberband=false
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
combo_as_lineedit=true
animate_states=true
button_contents_shift=false
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
groupbox_top_label=false
inline_spin_indicators=false
joined_inactive_tabs=false
layout_spacing=6
layout_margin=10
scrollbar_in_view=true
transient_scrollbar=false
transient_groove=false
submenu_overlap=0
tooltip_delay=-1
tree_branch_line=true
no_window_pattern=false
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,trojita,dragon,digikam
reduce_window_opacity=0
respect_DE=true
scrollable_menu=false
submenu_delay=250
no_inactiveness=false
reduce_menu_opacity=0
contrast=1.00
dialog_button_layout=1
intensity=1.00
saturation=1.00
click_behavior=0
shadowless_popup=false
drag_from_buttons=false
menu_blur_radius=5
tooltip_blur_radius=5

