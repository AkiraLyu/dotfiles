pkgname=dotfiles-kde-plugins
pkgver=@VERSION@
pkgrel=1
pkgdesc='Local App Grid, Kate translucent bars and WeChat KWin plugins'
arch=('x86_64')
license=('custom')
depends=(qt6-base qt6-declarative qt6-wayland kcoreaddons ktexteditor
         kwidgetsaddons kconfig kwindowsystem kwin libxcb wayland)
makedepends=(cmake ninja extra-cmake-modules)
options=('!debug' '!lto')
source=(appgrid.tar kate-translucent-bars.tar wechat-glass-live.tar source-manifest.json)
sha256sums=(@SHA256SUMS@)

build() {
    # Deliberately generic CPU flags; this package must be usable on a new CPU.
    export CFLAGS='-march=x86-64 -mtune=generic -O2 -pipe'
    export CXXFLAGS="$CFLAGS"
    for project in appgrid kate-translucent-bars wechat-glass-live; do
        cmake -S "$project" -B "build-$project" -G Ninja \
            -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
            -DCMAKE_INSTALL_LIBDIR=lib -DQT6_INSTALL_QML=/usr/lib/qt6/qml
        cmake --build "build-$project" --parallel 4
    done
}

check() {
    ctest --test-dir build-appgrid --output-on-failure
}

package() {
    for project in appgrid kate-translucent-bars wechat-glass-live; do
        DESTDIR="$pkgdir" cmake --install "build-$project"
    done
    install -Dm644 source-manifest.json "$pkgdir/usr/share/doc/$pkgname/source-manifest.json"
}
