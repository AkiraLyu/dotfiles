include "float.kdl"
// global
overview {
    zoom 0.60
    backdrop-color "#777777"
}

window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

prefer-no-csd

window-rule {
    match app-id="firefox"
    match app-id="code"
    open-maximized true
}

window-rule {
    match app-id="kitty"
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="code"
    background-effect {
        blur true
        xray true
    }
}

