[Desktop Entry]
Type=Application
Name=Toggle Color Theme
Name[zh_CN]=切换明暗主题
Comment=Synchronize KDE, Niri and application colors
Comment[zh_CN]=同步 KDE、Niri 和应用程序配色
Exec=theme toggle
Icon=preferences-desktop-theme
Terminal=false
Categories=Settings;DesktopSettings;
Actions=Light;Dark;BreezePreset;KvantumPreset;

[Desktop Action Light]
Name=Use Light Theme
Name[zh_CN]=使用浅色主题
Exec=theme light

[Desktop Action Dark]
Name=Use Dark Theme
Name[zh_CN]=使用深色主题
Exec=theme dark

[Desktop Action BreezePreset]
Name=Use Breeze Preset
Name[zh_CN]=使用 Breeze 预设
Exec=theme preset breeze

[Desktop Action KvantumPreset]
Name=Use Kvantum Preset
Name[zh_CN]=使用 Kvantum 预设
Exec=theme preset kvantum
