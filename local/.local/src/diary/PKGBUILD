# Maintainer: 拾光日记

pkgname=shiguang-diary
pkgver=1.0.0
pkgrel=2
pkgdesc='本地优先的 Markdown 日记查看、编辑与文本洞察应用'
arch=('x86_64')
license=('custom')
depends=('electron>=43' 'xdg-desktop-portal' 'glibc')
makedepends=('wayland' 'nodejs>=24' 'npm')
options=('!strip' '!debug')

# This is a local-worktree package: package() deliberately copies only the
# runtime files listed below instead of bundling Electron or node_modules.
build() {
  sh "$startdir/native/linux-wayland-blur/build.sh" \
    "$srcdir/native-wayland-blur"
}

check() {
  cd "$startdir"
  npm test
}

package() {
  local app_root="$pkgdir/usr/lib/$pkgname"

  install -d "$app_root/electron" "$app_root/public"
  cp -R "$startdir/electron/." "$app_root/electron/"
  cp -R "$startdir/public/." "$app_root/public/"
  install -Dm644 "$startdir/package.json" "$app_root/package.json"
  install -Dm755 "$srcdir/native-wayland-blur/libshiguang-wayland-blur.so" \
    "$app_root/libshiguang-wayland-blur.so"

  install -Dm755 "$startdir/packaging/shiguang-diary" \
    "$pkgdir/usr/bin/shiguang-diary"
  install -Dm644 "$startdir/packaging/dev.local.shiguang.diary.desktop" \
    "$pkgdir/usr/share/applications/dev.local.shiguang.diary.desktop"
  install -Dm644 "$startdir/build/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/dev.local.shiguang.diary.png"
  install -Dm644 "$startdir/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  if [[ -f "$startdir/source-manifest.json" ]]; then
    install -Dm644 "$startdir/source-manifest.json" \
      "$pkgdir/usr/share/doc/$pkgname/source-manifest.json"
  fi
  install -Dm644 "$startdir/native/linux-wayland-blur/LICENSE.open-orpheus" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.open-orpheus"
}
