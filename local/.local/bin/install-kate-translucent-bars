#!/bin/bash

set -euo pipefail

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
script_dir=$(dirname -- "$script_path")
source_dir=$(realpath -- "$script_dir/../src/kate-translucent-bars")
install_prefix=${KATE_TRANSLUCENT_BARS_PREFIX:-"$HOME/.local"}
plugin_file=$install_prefix/lib/qt6/plugins/kf6/ktexteditor/katetranslucentbarsplugin.so
wrapper_link=$HOME/.local/bin/kate
wrapper_source=$script_dir/kate
kate_data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}/kate
build_dir=$(mktemp -d /tmp/kate-translucent-bars-build.XXXXXX)

cleanup() {
    find "$build_dir" -depth -delete 2>/dev/null || true
}
trap cleanup EXIT

if [[ -e $wrapper_link && ! -L $wrapper_link ]]; then
    printf 'Refusing to replace non-symlink: %s\n' "$wrapper_link" >&2
    exit 1
fi
if [[ -L $wrapper_link && $(readlink -f -- "$wrapper_link") != $(readlink -f -- "$wrapper_source") ]]; then
    printf 'Refusing to replace unrelated symlink: %s\n' "$wrapper_link" >&2
    exit 1
fi

cmake -S "$source_dir" -B "$build_dir" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$install_prefix"
cmake --build "$build_dir"
cmake --install "$build_dir"

mkdir -p "$(dirname -- "$wrapper_link")"
ln -sfn "$wrapper_source" "$wrapper_link"

kwriteconfig6 --file katerc --group 'Kate Plugins' \
    --key katetranslucentbarsplugin --type bool true

mkdir -p "$kate_data_home"
kwriteconfig6 --file "$kate_data_home/anonymous.katesession" \
    --group 'Kate Plugins' --key katetranslucentbarsplugin --type bool true
if [[ -d $kate_data_home/sessions ]]; then
    while IFS= read -r -d '' session_file; do
        kwriteconfig6 --file "$session_file" --group 'Kate Plugins' \
            --key katetranslucentbarsplugin --type bool true
    done < <(find "$kate_data_home/sessions" -maxdepth 1 -type f -name '*.katesession' -print0)
fi

printf 'Installed %s\n' "$plugin_file"
printf 'Kate must be restarted before the new plugin can be discovered.\n'
