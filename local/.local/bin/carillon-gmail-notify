#!/usr/bin/env python3

from __future__ import annotations

import html
import imaplib
import os
from pathlib import Path
import re
import subprocess
import sys
import tomllib
from email import policy
from email.message import Message
from email.parser import BytesParser
from html.parser import HTMLParser
from urllib.parse import urlsplit


IMAP_FETCH_LIMIT = 128 * 1024
IMAP_TIMEOUT = 10
PREVIEW_LIMIT = 240

GMAIL_DESKTOP_ID = "chrome-fmgjjmmmlfnkbppncabfkddbjimcfncm-Default"
GMAIL_ICON = str(
    Path.home() / ".local/share/icons/hicolor/256x256/apps/dotfiles-gmail.png"
)


def account_config() -> dict:
    path = Path(
        os.environ.get(
            "CARILLON_CONFIG", str(Path.home() / ".config/carillon/config.toml")
        )
    ).expanduser()
    accounts = tomllib.loads(path.read_text())["accounts"]
    if name := os.environ.get("CARILLON_ACCOUNT"):
        return accounts[name]
    return next(account for account in accounts.values() if account.get("default"))


class _HTMLTextExtractor(HTMLParser):
    _BLOCK_TAGS = {
        "br",
        "div",
        "p",
        "li",
        "tr",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
    }

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self._ignored_depth = 0
        self._chunks: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        tag = tag.lower()
        if tag in {"script", "style", "head"}:
            self._ignored_depth += 1
        elif not self._ignored_depth and tag in self._BLOCK_TAGS:
            self._chunks.append("\n")

    def handle_endtag(self, tag: str) -> None:
        tag = tag.lower()
        if tag in {"script", "style", "head"}:
            self._ignored_depth = max(0, self._ignored_depth - 1)
        elif not self._ignored_depth and tag in self._BLOCK_TAGS:
            self._chunks.append("\n")

    def handle_data(self, data: str) -> None:
        if not self._ignored_depth:
            self._chunks.append(data)

    def text(self) -> str:
        return " ".join(self._chunks)


def _decode_part(part: Message) -> str:
    try:
        content = part.get_content()
        if isinstance(content, str):
            return content
    except Exception:
        pass

    payload = part.get_payload(decode=True)
    if isinstance(payload, bytes):
        charsets = [part.get_content_charset(), "utf-8", "latin-1"]
        for charset in filter(None, charsets):
            try:
                return payload.decode(charset, errors="replace")
            except LookupError:
                continue

    payload = part.get_payload()
    return payload if isinstance(payload, str) else ""


def _html_to_text(source: str) -> str:
    parser = _HTMLTextExtractor()
    try:
        parser.feed(source)
        parser.close()
        return parser.text()
    except Exception:
        return re.sub(r"<[^>]+>", " ", source)


def _normalize_preview(text: str) -> str:
    text = re.sub(r"[\u200b-\u200d\ufeff]", "", text)
    text = re.sub(r"\s+", " ", text).strip()
    if len(text) <= PREVIEW_LIMIT:
        return text
    return text[: PREVIEW_LIMIT - 1].rstrip() + "…"


def extract_preview(raw_message: bytes) -> str:
    message = BytesParser(policy=policy.default).parsebytes(raw_message)
    plain_parts: list[str] = []
    html_parts: list[str] = []

    for part in message.walk():
        if part.is_multipart() or part.get_content_disposition() == "attachment":
            continue

        content_type = part.get_content_type()
        if content_type == "text/plain":
            plain_parts.append(_decode_part(part))
        elif content_type == "text/html":
            html_parts.append(_decode_part(part))

    for text in plain_parts:
        preview = _normalize_preview(text)
        if preview:
            return preview

    for source in html_parts:
        preview = _normalize_preview(_html_to_text(source))
        if preview:
            return preview

    return ""


def fetch_message(uid: str) -> tuple[str, str, str]:
    if not uid.isascii() or not uid.isdigit():
        raise ValueError("Expected a numeric IMAP UID")

    account = account_config()
    # 与 Carillon 的配置保持一致：协议、认证和邮箱均在 imap 节点下。
    imap = account["imap"]
    server = urlsplit(imap["server"])
    if server.scheme != "imaps" or not server.hostname:
        raise ValueError("Gmail preview requires IMAP with TLS")
    auth = imap["sasl"]["plain"]
    command = auth["password"]["command"]
    password = subprocess.run(
        ["/bin/sh", "-c", command] if isinstance(command, str) else command,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=IMAP_TIMEOUT,
    ).stdout.rstrip("\r\n")

    client: imaplib.IMAP4_SSL | None = None
    try:
        client = imaplib.IMAP4_SSL(
            server.hostname,
            server.port or 993,
            timeout=IMAP_TIMEOUT,
        )
        client.login(auth["username"], password)
        status, _ = client.select(imap["mailbox"], readonly=True)
        if status != "OK":
            raise RuntimeError("Cannot open the configured mailbox")

        status, response = client.uid(
            "fetch",
            uid,
            f"(BODY.PEEK[]<0.{IMAP_FETCH_LIMIT}>)",
        )
        if status != "OK":
            raise RuntimeError("Cannot fetch the new message")

        chunks = [
            item[1]
            for item in response
            if isinstance(item, tuple) and len(item) > 1 and isinstance(item[1], bytes)
        ]
        raw_message = b"".join(chunks)
        message = BytesParser(policy=policy.default).parsebytes(raw_message)
        return (
            str(message.get("From", "")),
            str(message.get("Subject", "")),
            extract_preview(raw_message),
        )
    finally:
        if client is not None:
            try:
                client.logout()
            except Exception:
                pass


def show_notification(sender: str, subject: str, preview: str) -> None:
    title = f"📫 来自 {sender or '未知发件人'} 的新邮件"
    body = f"<b>{html.escape(subject or '（无主题）')}</b>"
    if preview:
        body += f"\n{html.escape(preview)}"

    result = subprocess.run(
        [
            "notify-send",
            "--app-name=Gmail",
            f"--icon={GMAIL_ICON}",
            f"--app-icon={GMAIL_ICON}",
            f"--hint=string:desktop-entry:{GMAIL_DESKTOP_ID}",
            "--action=default=打开 Gmail",
            title,
            body,
        ],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )

    if result.stdout.strip() == "default":
        subprocess.Popen(
            ["gtk-launch", GMAIL_DESKTOP_ID],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )


def main() -> int:
    # Only the numeric UID enters the shell hook; mail headers are fetched as data.
    if len(sys.argv) != 2 or not sys.argv[1].isascii() or not sys.argv[1].isdigit():
        return 2

    try:
        sender, subject, preview = fetch_message(sys.argv[1])
    except Exception:
        sender, subject, preview = "", "新邮件（预览暂不可用）", ""

    show_notification(sender, subject, preview)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
