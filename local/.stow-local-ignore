# Preserve GNU Stow's default exclusions.
RCS
.+,v
CVS
\.\#.+
\.cvsignore
\.svn
_darcs
\.hg
\.git
\.gitignore
\.gitmodules
.+~
\#.*\#
^/README.*
^/LICENSE.*
^/COPYING
__pycache__

# Native build outputs are not deployment input.
^/\.local/src/(appgrid/build|wechat-glass-live/(build|build-[^/]+))(/|$)

# Diary content, development dependencies and generated outputs stay local.
^/\.local/src/diary/(node_modules|Diary|dist|pkg|src|\.electron-test|\.diary-trash|\.shiguang|build/native|native/linux-wayland-blur/build)(/|$)
^/\.local/src/diary/(\.[^/]*-test-[^/]*|01_[^/]*\.md|[^/]*\.pkg\.tar\.[^/]+|[^/]*\.log)(/|$)
