# 暂时只保留 target 的会话关系，不自动启动旧服务。
# 恢复对应程序后，再按需取消下面 Wants= 行的注释。
[Unit]
Description=Personal Niri session services
Requisite=niri.service
After=niri.service
PartOf=niri.service
# Wants=niri-noctalia.service
# Wants=niri-clipboard-text.service
# Wants=niri-clipboard-image.service
# Wants=niri-polkit-agent.service

[Install]
WantedBy=niri.service
