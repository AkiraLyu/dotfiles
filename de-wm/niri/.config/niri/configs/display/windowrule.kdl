include "float.kdl"
// global
overview {
    zoom 0.60
    backdrop-color "#777777"
}

window-rule {
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}

prefer-no-csd

window-rule {
    match app-id="firefox"
    match app-id="code"
    open-maximized true
}

window-rule {
    match app-id="kitty"
    background-effect {
        blur true
        xray false
    }
}

// Blur the background behind pop-up menus in Nautilus.
window-rule {
    match app-id="dolphin"

    popups {
        geometry-corner-radius 12
        shadow {
            on
            softness 10
             spread 2
            offset x=0 y=5
            color "#0007"
        }
    }
}

window-rule {
    match app-id="Codex"
    background-effect {
        blur false
    }
    shadow {
        off
    }
}

window-rule {
    match app-id="netease-cloud-music-web-player"
    default-column-width { fixed 1100; }
}

window-rule {
    match app-id="md.obsidian.Obsidian"
    opacity 0.999
}
