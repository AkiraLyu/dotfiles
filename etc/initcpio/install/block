#!/usr/bin/env bash
# Akira: loading drivers/mfd in the initramfs makes this device's touchpad fail.
# Keep the workaround outside pacman-owned files, while using the current block
# hook for every other driver. See docs/ARCH_INSTALL.md before removing it.

source /usr/lib/initcpio/install/block || return
eval "$(declare -f build | sed '1s/^build /_dotfiles_block_build /')"

build() {
    local original_checked_modules result=0
    original_checked_modules=$(declare -f add_checked_modules) || return
    eval "${original_checked_modules/#add_checked_modules /_dotfiles_checked_modules }"

    add_checked_modules() {
        local argument
        for argument in "$@"; do
            # The stock hook makes this a separate invocation. Do not skip any
            # of its other calls or blacklist these drivers in the running OS.
            if [[ $argument == /drivers/mfd/ ]]; then
                return 0
            fi
        done
        _dotfiles_checked_modules "$@"
    }

    _dotfiles_block_build "$@" || result=$?
    eval "$original_checked_modules"
    unset -f _dotfiles_checked_modules
    return "$result"
}
