[Unit]
Description=OpenCodex proxy
Requisite=graphical-session.target
After=graphical-session.target
PartOf=graphical-session.target personal-graphical.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ocx start
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
