pkgname=xwayland-satellite-akira
pkgver=0.8.2.r1.gb517bcb
pkgrel=1
pkgdesc='Xwayland satellite with AkiraLyu customizations (pinned source)'
arch=('x86_64')
url='https://github.com/AkiraLyu/xwayland-satellite'
license=('MPL-2.0')
depends=(glibc libgcc libxcb xcb-util-cursor xorg-xwayland)
makedepends=(clang rust)
provides=('xwayland-satellite=0.8.2')
conflicts=(xwayland-satellite)
options=('!lto' '!debug')
_commit=b517bcb74b2de835651749323b4fd4e269270e17
source=("xwayland-satellite-${_commit}.tar.gz::https://github.com/AkiraLyu/xwayland-satellite/archive/${_commit}.tar.gz")
sha256sums=('34cc589d82bffba27eb05181fd1ef0dd9bc83c9c22e99fe146497128a505ee1d')

prepare() {
    cd "xwayland-satellite-${_commit}"
    # The upstream example defaults to /usr/local/bin; this is a pacman package.
    sed -i 's|ExecStart=/usr/local/bin/|ExecStart=/usr/bin/|' resources/xwayland-satellite.service
    export RUSTUP_TOOLCHAIN=1.96.0
    export RUSTFLAGS='-C opt-level=3'
    cargo fetch --locked
}

build() {
    cd "xwayland-satellite-${_commit}"
    export RUSTUP_TOOLCHAIN=1.96.0
    export RUSTFLAGS='-C opt-level=3'
    cargo build --frozen --release --features systemd
}

check() {
    cd "xwayland-satellite-${_commit}"
    export RUSTUP_TOOLCHAIN=1.96.0
    export RUSTFLAGS='-C opt-level=3'
    # The library tests need no compositor; integration tests launch a compositor.
    cargo test --frozen --lib --features systemd
}

package() {
    cd "xwayland-satellite-${_commit}"
    install -Dm755 target/release/xwayland-satellite "$pkgdir/usr/bin/xwayland-satellite"
    install -Dm644 resources/xwayland-satellite.service "$pkgdir/usr/lib/systemd/user/xwayland-satellite.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
