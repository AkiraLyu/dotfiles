prepare() {
    cd "gamescope-${_commit}"
    cp -a "$srcdir/wlroots-88a869855742281c98c22cab9641b317b8d065ef/." "subprojects/wlroots/"
    cp -a "$srcdir/libliftoff-8b08dc1c14fd019cc90ddabe34ad16596b0691f4/." "subprojects/libliftoff/"
    cp -a "$srcdir/libdisplay-info-47a5590e9c4eb35d67651b8c05a55f1a48259329/." "subprojects/libdisplay-info/"
    cp -a "$srcdir/vkroots-5106d8a0df95de66cc58dc1ea37e69c99afc9540/." "subprojects/vkroots/"
    cp -a "$srcdir/openvr-ff87f683f41fe26cc9353dd9d9d7028357fd8e1a/." "subprojects/openvr/"
    cp -a "$srcdir/reshade-696b14cd6006ae9ca174e6164450619ace043283/." "src/reshade/"
    cp -a "$srcdir/SPIRV-Headers-d790ced752b5bfc06b6988baadef6eb2d16bdf96/." "thirdparty/SPIRV-Headers/"
    cp -a "$srcdir/glm-0af55ccecd98d4e5a8d1fad7de25ba429d60e863/." "subprojects/glm/"
    cp -a "$srcdir/stb-5736b15f7ea0ffb08dd38af21067c314d6a3aae9/." "subprojects/stb/"
    sed -i -e "/^vcs_tag_cmd =/d" -e "s/^vcs_tag = .*/vcs_tag = '$pkgver'/" src/meson.build
    # Git-free archives need the wrap overlays for the two header-only projects.
    cp -a subprojects/packagefiles/glm/. subprojects/glm/
    cp -a subprojects/packagefiles/stb/. subprojects/stb/
}

build() {
    export CFLAGS='-O2 -pipe'
    export CXXFLAGS='-O2 -pipe'
    meson setup build "gamescope-${_commit}" --prefix=/usr --libdir=lib \
        --buildtype=release --wrap-mode=nodownload -Db_lto=false \
        -Dpipewire=enabled -Drt_cap=enabled -Ddrm_backend=enabled \
        -Dsdl2_backend=enabled -Davif_screenshots=enabled -Dinput_emulation=enabled
    meson compile -C build -j 2
}

check() {
    meson test -C build --print-errorlogs
    build/src/gamescope --help 2>&1 | grep -i 'anime4k'
}

package() {
    DESTDIR="$pkgdir" meson install -C build --skip-subprojects
    install -Dm644 "gamescope-${_commit}/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "gamescope-${_commit}/src/reshade/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.reshade"
}
