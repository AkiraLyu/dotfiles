pkgname=foxvault-git
pkgver=0.1.0.r5.gba885c1
pkgrel=3
pkgdesc='Firefox history archiver from AkiraLyu/FoxVault (pinned source)'
arch=('x86_64')
url='https://github.com/AkiraLyu/FoxVault'
license=('LicenseRef-Unknown')
depends=(glibc libgcc libstdc++ fontconfig libglvnd libx11 libxcursor libxi libxrandr libxkbcommon wayland)
makedepends=(rust)
provides=(foxvault)
conflicts=(foxvault)
options=('!lto' '!debug')
_commit=ba885c1f4f97c97f32bdb041297d743e188232e7
source=("FoxVault-${_commit}.tar.gz::https://github.com/AkiraLyu/FoxVault/archive/${_commit}.tar.gz" foxvault.service)
sha256sums=('bb92fd901cf5ba7ee5842dd8a3e45138d26e35b9abd04b21c3e4aa6944aeff1f' '0fc00b1b31ab30a77c17b75c413b4d74929198b10c6a50e7a99d4915ef9508c8')

prepare() {
    cd "FoxVault-${_commit}"
    export RUSTUP_TOOLCHAIN=1.96.0
    cargo fetch --locked
}

build() {
    cd "FoxVault-${_commit}"
    export RUSTUP_TOOLCHAIN=1.96.0
    export RUSTFLAGS='-C opt-level=3'
    cargo build --frozen --release --jobs 2
}

check() {
    cd "FoxVault-${_commit}"
    export RUSTUP_TOOLCHAIN=1.96.0
    export RUSTFLAGS='-C opt-level=3'
    cargo test --frozen --release --jobs 2
}

package() {
    cd "FoxVault-${_commit}"
    install -Dm755 target/release/FoxVault "$pkgdir/usr/bin/FoxVault"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 config.example.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
    install -Dm644 "$srcdir/foxvault.service" "$pkgdir/usr/lib/systemd/user/foxvault.service"
}
