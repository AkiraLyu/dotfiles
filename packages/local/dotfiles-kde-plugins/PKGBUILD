# 在当前仓库内构建；源码直接取自 local/.local/src/，不生成中间源码归档。
pkgname=dotfiles-kde-plugins
pkgver=1.0
pkgrel=2
pkgdesc='Darkly translucent bars for Kate and the WeChat Glass KWin effect'
arch=('x86_64')
license=('GPL-2.0-or-later')
depends=(kate kwin qt6-base qt6-declarative kcoreaddons ktexteditor kwidgetsaddons kconfig libxcb)
makedepends=(cmake ninja extra-cmake-modules)
options=('!debug' '!lto')

# startdir 是这份 PKGBUILD 所在目录，与调用 makepkg 时的 shell 目录无关。
_source_root="$startdir/../../../local/.local/src"
_projects=(kate-translucent-bars wechat-glass-live)

build() {
    # 使用通用 CPU 选项，避免本机 makepkg.conf 的 -march=native 限制迁移。
    export CFLAGS='-march=x86-64 -mtune=generic -O2 -pipe'
    export CXXFLAGS="$CFLAGS"
    for project in "${_projects[@]}"; do
        cmake -S "$_source_root/$project" -B "$srcdir/build-$project" -G Ninja \
            -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib
        cmake --build "$srcdir/build-$project" --parallel 2
    done
}

package() {
    # DESTDIR 只写入打包目录；真正安装统一交给 pacman。
    for project in "${_projects[@]}"; do
        DESTDIR="$pkgdir" cmake --install "$srcdir/build-$project"
    done
}
