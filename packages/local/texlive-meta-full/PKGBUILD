# 根据本机已安装元包的依赖和原始说明保存；不包含程序二进制。
pkgname=texlive-meta-full
pkgver=1
pkgrel=2
pkgdesc='Meta package that depends on all texlive packages'
arch=('any')
license=('custom:none')
# 元包只有说明文件，无需生成调试包。
options=('!debug')

# 修改软件组合时，直接增删下面的包名。
depends=(
    texlive-basic
    texlive-bibtexextra
    texlive-binextra
    texlive-context
    texlive-fontsextra
    texlive-fontsrecommended
    texlive-fontutils
    texlive-formatsextra
    texlive-games
    texlive-humanities
    texlive-latex
    texlive-latexextra
    texlive-latexrecommended
    texlive-luatex
    texlive-mathscience
    texlive-metapost
    texlive-music
    texlive-pictures
    texlive-plaingeneric
    texlive-pstricks
    texlive-publishers
    texlive-xetex
    texlive-langchinese
)

package() {
    install -Dm644 "$startdir/README" "$pkgdir/usr/share/doc/$pkgname/README"
}
