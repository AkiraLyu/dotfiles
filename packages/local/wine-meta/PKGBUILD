# 根据本机已安装元包的依赖和原始说明保存；不包含程序二进制。
pkgname=wine-meta
pkgver=11.0
pkgrel=1
pkgdesc='Meta package for wine and related addons'
arch=('any')
license=('custom:none')
# 元包只有说明文件，无需生成调试包。
options=('!debug')

# 修改软件组合时，直接增删下面的包名。
depends=(
    wine
    wine-gecko
    wine-mono
    winetricks
)

package() {
    install -Dm644 "$startdir/README" "$pkgdir/usr/share/doc/$pkgname/README"
}
